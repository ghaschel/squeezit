{
  "name": "squeezit",
  "version": "2.0.7",
  "description": "Lossless image optimizer CLI, JS/TS API, and bundler plugins for PNG, JPEG, GIF, WebP, SVG, AVIF, HEIC, JXL, ICO, BMP, and more.",
  "license": "MIT",
  "homepage": "https://github.com/ghaschel/squeezit#readme",
  "bugs": {
    "url": "https://github.com/ghaschel/squeezit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ghaschel/squeezit.git"
  },
  "packageManager": "bun@1.3.5",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.13.0",
    "parcel": "^2.16.0"
  },
  "keywords": [
    "squeezit",
    "image",
    "images",
    "image-compression",
    "image-optimizer",
    "image-optimization",
    "lossless",
    "lossless-compression",
    "compress-images",
    "optimize-images",
    "cli",
    "javascript",
    "typescript",
    "vite-plugin",
    "webpack-plugin",
    "rollup-plugin",
    "parcel-plugin",
    "astro-integration",
    "esbuild-plugin",
    "gulp-plugin",
    "grunt-plugin",
    "nextjs",
    "png",
    "jpeg",
    "webp",
    "avif",
    "heic",
    "svg"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "sqz": "./bin/run.js",
    "squeezit": "./bin/run.js"
  },
  "oclif": {
    "bin": "sqz",
    "binAliases": [
      "squeezit"
    ],
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found"
    ],
    "update": {
      "node": {
        "version": "24.16.0",
        "targets": [
          "darwin-arm64",
          "darwin-x64",
          "linux-x64"
        ]
      }
    },
    "topicSeparator": " "
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./gulp": {
      "import": {
        "types": "./dist/gulp.d.ts",
        "default": "./dist/gulp.js"
      },
      "require": {
        "types": "./dist/gulp.d.cts",
        "default": "./dist/gulp.cjs"
      }
    },
    "./grunt": {
      "import": {
        "types": "./dist/grunt.d.ts",
        "default": "./dist/grunt.js"
      },
      "require": {
        "types": "./dist/grunt.d.cts",
        "default": "./dist/grunt.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/rollup.d.ts",
        "default": "./dist/rollup.js"
      },
      "require": {
        "types": "./dist/rollup.d.cts",
        "default": "./dist/rollup.cjs"
      }
    },
    "./parcel": {
      "import": {
        "types": "./dist/parcel.d.ts",
        "default": "./dist/parcel.js"
      },
      "require": {
        "types": "./dist/parcel.d.cts",
        "default": "./dist/parcel.cjs"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/astro.d.ts",
        "default": "./dist/astro.js"
      },
      "require": {
        "types": "./dist/astro.d.cts",
        "default": "./dist/astro.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./esbuild": {
      "import": {
        "types": "./dist/esbuild.d.ts",
        "default": "./dist/esbuild.js"
      },
      "require": {
        "types": "./dist/esbuild.d.cts",
        "default": "./dist/esbuild.cjs"
      }
    },
    "./babel": {
      "import": {
        "types": "./dist/babel.d.ts",
        "default": "./dist/babel.js"
      },
      "require": {
        "types": "./dist/babel.d.cts",
        "default": "./dist/babel.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "bin",
    "docs",
    "dist",
    "oclif.manifest.json",
    "postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist oclif.manifest.json && bun run build:library && bun run build:cli && bun run build:manifest",
    "build:library": "tsup",
    "build:cli": "tsup --config tsup.oclif.config.ts",
    "build:manifest": "oclif manifest && printf '\\n' >> oclif.manifest.json",
    "prepack": "bun run build",
    "postinstall": "node ./postinstall.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/integration/api*.test.ts",
    "test:webp": "vitest run tests/integration/api-webp.test.ts",
    "test:cli": "bun run build:cli && bun run build:manifest && vitest run tests/unit/cli-*.test.ts tests/unit/oclif-packaging.test.ts tests/integration/cli-json.test.ts",
    "test:babel": "bun run build && vitest run tests/integration/babel.test.ts",
    "test:gulp": "vitest run tests/integration/gulp.test.ts",
    "test:grunt": "bun run build && vitest run tests/integration/grunt.test.ts",
    "test:esbuild": "vitest run tests/integration/esbuild.test.ts",
    "test:rollup": "vitest run tests/integration/rollup.test.ts",
    "test:parcel": "bun run build && vitest run tests/integration/parcel.test.ts",
    "test:astro": "bun run build && vitest run tests/integration/astro.test.ts",
    "test:vite": "vitest run tests/integration/vite.test.ts",
    "test:webpack": "vitest run tests/integration/webpack.test.ts",
    "test:next": "bun run build && vitest run tests/integration/next.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:exports": "bun run build:library && publint",
    "check:types": "HUSKY=0 npm_config_cache=.npm-cache attw --pack . --profile node16",
    "fixture-values": "bun run scripts/fixture-values.ts",
    "release:initial": "git fetch --tags --force && $ bunx -- commit-and-tag-version --release-as v1.0.0",
    "release": "git fetch --tags --force && bun scripts/check-release-readiness.ts && commit-and-tag-version",
    "postbump": "bun run build:cli && bun run build:manifest",
    "push": "git push --follow-tags",
    "release:check": "bun install --frozen-lockfile && bun run typecheck && bun run test:unit && bun run check:exports",
    "release:push": "bun run release:check && bun run push",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then husky; fi"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@babel/core": "^7.0.0",
    "astro": "^5.18.0",
    "@parcel/core": "^2.16.0",
    "@parcel/plugin": "^2.16.0",
    "@eslint/js": "^10.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/gulp": "^4.0.17",
    "@types/vinyl": "^2.0.12",
    "@vitest/coverage-v8": "^4.0.7",
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/bun": "latest",
    "block-no-verify": "^1.3.0",
    "commit-and-tag-version": "^12.7.0",
    "cz-git": "^1.12.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "esbuild": "^0.27.4",
    "gulp": "^5.0.1",
    "husky": "^9.1.7",
    "grunt": "^1.6.1",
    "lint-staged": "^16.4.0",
    "next": "^16.2.1",
    "oclif": "^4.23.28",
    "parcel": "^2.16.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.52.3",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tsup": "^8.5.0",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.2",
    "vitest": "^4.0.7",
    "vinyl": "^3.0.1",
    "webpack": "^5.105.4"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0",
    "esbuild": "^0.27.4",
    "gulp": "^5.0.1",
    "grunt": "^1.6.1",
    "next": "^16.2.1",
    "astro": "^5.18.0",
    "parcel": "^2.16.0",
    "rollup": "^4.52.3",
    "typescript": "^5",
    "vite": "^8.0.2",
    "webpack": "^5.105.4"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "gulp": {
      "optional": true
    },
    "grunt": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "parcel": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "dependencies": {
    "@oclif/core": "^4.13.2",
    "@oclif/plugin-autocomplete": "^3.2.52",
    "@oclif/plugin-not-found": "^3.2.88",
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.4",
    "glob": "^13.0.6",
    "listr2": "^11",
    "ora": "^9.3.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
