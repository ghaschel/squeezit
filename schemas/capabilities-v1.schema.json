{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ghaschel/squeezit/schemas/capabilities-v1.schema.json",
  "title": "Squeezit capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["commands", "schemas"],
  "properties": {
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "envelope",
        "events",
        "optimizationPlan",
        "runReceipt"
      ],
      "properties": {
        "capabilities": { "$ref": "#/$defs/schemaLocation" },
        "envelope": { "$ref": "#/$defs/schemaLocation" },
        "events": { "$ref": "#/$defs/schemaLocation" },
        "optimizationPlan": { "$ref": "#/$defs/schemaLocation" },
        "runReceipt": { "$ref": "#/$defs/schemaLocation" }
      }
    }
  },
  "$defs": {
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "multiple", "name", "required"],
      "properties": {
        "description": { "type": ["string", "null"] },
        "multiple": { "type": "boolean" },
        "name": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aliases",
        "arguments",
        "confirmation",
        "description",
        "effects",
        "events",
        "flags",
        "id",
        "json",
        "origin",
        "outputSchema",
        "receipt"
      ],
      "properties": {
        "aliases": { "type": "array", "items": { "type": "string" } },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/argument" }
        },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredWhen"],
          "properties": { "requiredWhen": { "type": "string" } }
        },
        "description": { "type": ["string", "null"] },
        "effects": { "type": "array", "items": { "type": "string" } },
        "events": { "$ref": "#/$defs/events" },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/flag" } },
        "id": { "type": "string" },
        "json": { "type": "boolean" },
        "origin": { "enum": ["external", "squeezit"] },
        "outputSchema": { "type": ["string", "null"] },
        "receipt": { "$ref": "#/$defs/receipt" }
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "char",
        "default",
        "description",
        "name",
        "options",
        "required",
        "type"
      ],
      "properties": {
        "char": { "type": ["string", "null"] },
        "default": {},
        "description": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "required": { "type": "boolean" },
        "type": { "type": "string" }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "lifecycle", "schema"],
      "properties": {
        "format": { "type": ["string", "null"] },
        "lifecycle": { "type": "array", "items": { "type": "string" } },
        "schema": { "type": ["string", "null"] }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resume", "schema", "supported"],
      "properties": {
        "resume": { "type": ["string", "null"] },
        "schema": { "type": ["string", "null"] },
        "supported": { "type": "boolean" }
      }
    },
    "schemaLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localPath", "url"],
      "properties": {
        "localPath": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
