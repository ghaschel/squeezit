{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ghaschel/squeezit/schemas/command-envelope-v2.schema.json",
  "title": "Squeezit command envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "data", "meta"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "command": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "data": { "type": "object" },
    "meta": { "$ref": "#/$defs/meta" },
    "error": { "$ref": "#/$defs/issue" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": { "const": "capabilities" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/capabilitiesData" } }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "commands" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": { "properties": { "data": { "$ref": "#/$defs/commandsData" } } }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "compress" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/optimizationData" } }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "metadata strip" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/optimizationData" } }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "deps doctor" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/dependenciesDoctorData" } }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "deps install" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/dependenciesInstallData" } }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "doctor" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": { "properties": { "data": { "$ref": "#/$defs/doctorData" } } }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "help" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": { "properties": { "data": { "$ref": "#/$defs/helpData" } } }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "version" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": { "properties": { "data": { "$ref": "#/$defs/versionData" } } }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "update check" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/updateCheckData" } }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "update apply" },
          "ok": { "const": true }
        },
        "required": ["command", "ok"]
      },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/updateApplyData" } }
      }
    }
  ],
  "$defs": {
    "capabilitiesData": { "$ref": "capabilities-v1.schema.json" },
    "commandsData": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "dependenciesDoctorData": {
      "type": "object",
      "required": ["scope", "inputs", "tools"],
      "properties": {
        "scope": { "enum": ["full", "selected-inputs"] },
        "inputs": { "type": "integer", "minimum": 0 },
        "tools": { "type": "array" },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "dependenciesInstallData": {
      "type": "object",
      "required": [
        "inputs",
        "packages",
        "installTargets",
        "installed",
        "missing"
      ],
      "properties": {
        "inputs": { "type": "integer", "minimum": 0 },
        "packages": { "type": "array", "items": { "type": "string" } },
        "installTargets": { "type": "array" },
        "installed": { "type": "boolean" },
        "missing": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "doctorData": {
      "type": "object",
      "required": ["runtime", "platform", "update", "installation", "tools"],
      "properties": {
        "runtime": { "type": "object" },
        "platform": { "type": "object" },
        "update": { "type": "object" },
        "installation": { "type": "object" },
        "tools": { "type": "array" },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "helpData": {
      "type": "object",
      "required": ["requestedCommand"],
      "properties": {
        "requestedCommand": { "type": ["string", "null"] },
        "commands": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "remediation"],
      "properties": {
        "code": {
          "enum": [
            "CONFIRMATION_REQUIRED",
            "DEPENDENCY_MISSING",
            "INTERNAL_ERROR",
            "OPERATION_CANCELLED",
            "SHADOWED_INSTALLATION",
            "STALE_INSTALLATION",
            "UNKNOWN_COMMAND",
            "UNSUPPORTED_FORMAT",
            "UNSUPPORTED_PLATFORM",
            "UPDATE_UNAVAILABLE",
            "VALIDATION_ERROR"
          ]
        },
        "message": { "type": "string" },
        "remediation": { "type": "string" },
        "details": { "type": "object" }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwd",
        "executablePath",
        "invocationPath",
        "nodeVersion",
        "packageRoot",
        "platform",
        "squeezitVersion"
      ],
      "properties": {
        "cwd": { "type": "string" },
        "executablePath": { "type": "string" },
        "invocationPath": { "type": "string" },
        "nodeVersion": { "type": "string" },
        "packageRoot": { "type": "string" },
        "platform": { "type": "string", "pattern": "^[a-z0-9]+-[a-z0-9]+$" },
        "squeezitVersion": { "type": "string" }
      }
    },
    "optimizationData": {
      "type": "object",
      "required": ["inputs", "results", "summary"],
      "properties": {
        "inputs": { "type": "integer", "minimum": 0 },
        "results": { "type": "array" },
        "summary": { "type": "object" },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "updateApplyData": { "type": "object" },
    "updateCheckData": { "type": "object" },
    "versionData": {
      "type": "object",
      "required": ["bin", "version"],
      "properties": {
        "bin": { "type": "string" },
        "version": { "type": "string" },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
